{
  "animation": {
    "name": "film-look",
    "title": "フィルム風",
    "description": "粒子・退色・周辺ぼけで温かい質感にする。",
    "category": "other",
    "tags": [
      "ルック",
      "エフェクト"
    ]
  },
  "inputs": {
    "grain": {
      "type": "number",
      "default": 0.06,
      "min": 0,
      "max": 1
    },
    "warmth": {
      "type": "number",
      "default": 0.25,
      "min": 0,
      "max": 1
    },
    "soften": {
      "type": "number",
      "unit": "px",
      "default": 6,
      "min": 0
    }
  },
  "produces": {
    "effects": [
      {
        "type": "colorAdjust",
        "saturation": -0.15,
        "contrast": 0.12,
        "gamma": 1.05
      },
      {
        "type": "gradientOverlay",
        "angle": 120,
        "blend": "overlay",
        "opacity": "${warmth}",
        "stops": [
          {
            "offset": 0,
            "color": "#ffce9e"
          },
          {
            "offset": 1,
            "color": "#5d7bb5"
          }
        ]
      },
      {
        "type": "peripheralBlur",
        "radius": 0.6,
        "softness": 0.45,
        "blur": "${soften}",
        "light": 0.12
      },
      {
        "type": "noise",
        "amount": "${grain}",
        "monochrome": true
      }
    ]
  }
}
