{
  "animation": {
    "name": "fade-in",
    "title": "フェードイン",
    "description": "不透明度を 0 から 1 へ。もっとも基本の登場。",
    "category": "in",
    "tags": [
      "登場",
      "opacity"
    ]
  },
  "inputs": {
    "delay": {
      "type": "number",
      "default": 0,
      "label": "開始"
    },
    "duration": {
      "type": "number",
      "default": 0.6,
      "min": 0.01
    },
    "from": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    },
    "easing": {
      "type": "text",
      "default": "easeOutCubic",
      "label": "イージング"
    }
  },
  "produces": {
    "animations": [
      {
        "property": "transform.opacity",
        "keyframes": [
          {
            "time": "${delay}",
            "value": "${from}"
          },
          {
            "time": "${delay + duration}",
            "value": 1,
            "easing": "${easing}"
          }
        ]
      }
    ]
  }
}
