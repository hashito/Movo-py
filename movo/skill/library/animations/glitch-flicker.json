{
  "animation": {
    "name": "glitch-flicker",
    "title": "グリッチのちらつき",
    "description": "グリッチの強さをランダムに変えて不安定さを出す。",
    "category": "accent",
    "tags": [
      "グリッチ",
      "noise"
    ]
  },
  "inputs": {
    "amount": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "interval": {
      "type": "number",
      "default": 2,
      "min": 1
    },
    "blocks": {
      "type": "number",
      "default": 12,
      "min": 1
    }
  },
  "produces": {
    "effects": [
      {
        "id": "glitchFlicker",
        "type": "glitch",
        "amount": {
          "modulator": {
            "type": "random-step",
            "frequency": 6,
            "amplitude": "${amount * 0.5}",
            "offset": "${amount * 0.6}",
            "clamp": [
              0,
              1
            ]
          }
        },
        "blocks": "${blocks}",
        "interval": "${interval}",
        "colorShift": 8
      }
    ]
  }
}
