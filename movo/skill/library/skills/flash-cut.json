{
  "skill": {
    "name": "flash-cut",
    "title": "フラッシュカット",
    "description": "白く飛ばして集中線が散る、勢いのある切り替え。他の映像に重ねて使う（単体だと最後は透明になる）。",
    "category": "transition",
    "tags": [
      "フラッシュ",
      "カットイン"
    ],
    "learnedFrom": [
      "https://zuariya.com/%E3%80%90aviutl%E3%80%91mad%E3%81%A7%E8%B6%85%E4%BD%BF%E3%81%88%E3%82%8B%E3%83%86%E3%82%AF%E3%83%8B%E3%83%83%E3%82%AF%E9%9B%86/"
    ]
  },
  "inputs": {
    "color": {
      "type": "color",
      "default": "#ffffff"
    },
    "duration": {
      "type": "number",
      "default": 0.6,
      "min": 0.05
    },
    "lines": {
      "type": "boolean",
      "default": true
    }
  },
  "duration": "${duration}",
  "video": {
    "width": 1920,
    "height": 1080,
    "background": "#000000"
  },
  "layers": [
    {
      "id": "${_id}-flash",
      "type": "shape",
      "shape": {
        "type": "rectangle",
        "width": "${width}",
        "height": "${height}",
        "fill": "${color}"
      },
      "transform": {
        "x": "${centerX}",
        "y": "${centerY}",
        "anchorX": 0.5,
        "anchorY": 0.5
      },
      "animations": [
        {
          "property": "transform.opacity",
          "keyframes": [
            {
              "time": 0,
              "value": 1
            },
            {
              "time": "${duration}",
              "value": 0,
              "easing": "easeOutQuad"
            }
          ]
        }
      ]
    },
    {
      "when": "${lines}",
      "id": "${_id}-burst",
      "type": "speedLines",
      "speedLines": {
        "count": 220,
        "innerRadius": {
          "keyframes": [
            {
              "time": 0,
              "value": 0
            },
            {
              "time": "${duration}",
              "value": 1.1,
              "easing": "easeOutExpo"
            }
          ]
        },
        "thickness": "${max(1, 1.6 * scale)}",
        "density": 0.7,
        "color": "${color}"
      },
      "transform": {
        "x": "${centerX}",
        "y": "${centerY}",
        "width": "${width}",
        "height": "${height}",
        "anchorX": 0.5,
        "anchorY": 0.5
      },
      "animations": [
        {
          "property": "transform.opacity",
          "keyframes": [
            {
              "time": 0,
              "value": 0.9
            },
            {
              "time": "${duration}",
              "value": 0
            }
          ]
        }
      ]
    }
  ]
}
